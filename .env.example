# Example environment variables
# Copy this file to .env and fill in real values
# .env is gitignored and will not be pushed

# Path to the raw dataset folder
DR_SRC_DIR=./data/diabetic-retinopathy-detection

# Path to the preprocessed dataset folder
DR_DST_DIR=./data/diabetic-retinopathy-detection/train_proc

# Random seed for reproducible splits
SEED=42
