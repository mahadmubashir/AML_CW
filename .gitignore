# === data folders — never push, never even stage ===
# 'data' (no slash) catches the symlink. 'data/' catches a real folder.
data
data/
!data/.gitkeep

# === model checkpoints — large binaries, never push ===
checkpoints/
outputs/checkpoints/
outputs/baseline/checkpoints/
*.pt
*.pth

# === training outputs — large or environment-specific ===
logs/
outputs/logs/
wandb/

# === environment-specific run scripts — local only ===
scripts/

# === private local-only folder ===
local_only/

# === Python ===
__pycache__/
*.py[cod]
*.so
*.egg-info/
.ipynb_checkpoints/

# === environments ===
venv/
.venv/
.env
.env.*
!.env.example

# === editors + os ===
.DS_Store
.vscode/
.idea/
Thumbs.db

# === backups + temp files ===
*.bak
*.backup
*.tmp
*.swp
*~

# === smoke test files — private, never push ===
notebooks/dr_smoke_test*.ipynb
notebooks/*_executed_cpu.ipynb

# === bundles and archives ===
*.bundle
*.zip.*

# === training run artefacts — local only, never push ===
# any per-run output folder under outputs/ (catches mobilenetv3_large_*, exp*, etc)
outputs/*/
# log files anywhere
*.log
*.err
*.out
# === training scripts — environment-specific, local only ===
mobilenet_train.py
run_data_preprocessing.py
resume_data_preprocessing.py
submit_*.sh

# === local-only helper scripts (one-shot patchers + runners) ===
patch_run_*.py
preflight_check.py
run_exp*.py

# === notebook backups with unix-timestamp suffix ===
*.ipynb.bak.*

# build-time helper scripts (kept on dev machine, not deliverable)
add_section_m.py
inspect_section_m.py
fix_runs_6_to_9.py
strip_remaining_noise_v2.py
diagnose_run9_noise.py
clean_section_20_dashes.py
clean_section_20_reasoning.py
strip_all_comments.py
find_triple_quoted.py
build_explainability_nb.py
inspect_explainability.py
build_telegram_message.py
build_ablation_csv.py
build_ablation_xlsx.py
build_ablation_xlsx_v2.py
outputs/ablation_full_metrics.csv
outputs/ablation_full_metrics.xlsx
strip_summary_listing.py
